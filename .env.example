APP_NAME=YourERP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_CURRENCY=IDR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Default Laravel/Filament disk; some CESA plugins use their own disk settings.
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# Recruitment CVs, photos, and notification attachments: local, public, or s3.
# local is private; public requires php artisan storage:link; s3 requires AWS_* below.
# Changing the disk affects new uploads and does not migrate existing files.
REKRUTMEN_FILESYSTEM_DISK=public
# Job posting thumbnails follow the recruitment disk; override with local, public, or s3.
REKRUTMEN_THUMBNAIL_DISK="${REKRUTMEN_FILESYSTEM_DISK}"

# Recruitment AI screening via an OpenAI-compatible chat completions endpoint.
# Defaults below bootstrap the UI settings. Saved Master Rekrutmen settings take priority.
REKRUTMEN_AI_AUTOMATIC=true
REKRUTMEN_AI_REQUESTS_PER_MINUTE=20
OPENAI_COMPATIBLE_BASE_URL=https://router.rizqis.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=ag/gemini-3.7-flash-low

# Helpdesk ticket and comment attachments use independent disks and visibility settings.
HELPDESK_TICKET_ATTACHMENT_DISK=public
HELPDESK_TICKET_ATTACHMENT_VISIBILITY=public
HELPDESK_COMMENT_ATTACHMENT_DISK=public
HELPDESK_COMMENT_ATTACHMENT_VISIBILITY=public

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log records email locally; configure SMTP here for actual delivery by other CESA plugins.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Configure recruitment SMTP in the recruitment Settings UI (stored in the database).
# MAIL_* provides fallback settings when the database configuration is not enabled.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Workers must listen to the configured queues, for example:
# php artisan queue:work --queue=default,notifications,whatsapp
# Automatic CV screening uses default; keep its worker running on the server.
# Recruitment scheduled notifications also require php artisan schedule:run every minute
# (or php artisan schedule:work during local development).
FORM_TRANSFER_NOTIFICATION_QUEUE=notifications
EXIT_CLEARANCE_NOTIFICATION_QUEUE=notifications
REKRUTMEN_NOTIFICATION_QUEUE=notifications

NOTIFICATION_MAIL_THROTTLE_ENABLED=true
NOTIFICATION_MAIL_THROTTLE_MIN_INTERVAL=2
NOTIFICATION_MAIL_THROTTLE_MAX_INTERVAL=5
NOTIFICATION_MAIL_THROTTLE_KEY=global

# WAG gateway for Form Transfer / Exit Clearance delivery and Lead number validation.
# These integrations are enabled only when both URL and token are configured.
WAG_URL=https://waghub.mekayastudio.com
WAG_TOKEN=
WHATSAPP_COUNTRY_CODE=62
WHATSAPP_QUEUE=whatsapp
WHATSAPP_CONNECTION=null
WHATSAPP_TIMEOUT=10
WHATSAPP_TRIES=3
WHATSAPP_BACKOFF=10,30,60
WHATSAPP_THROTTLE_ENABLED=true
WHATSAPP_THROTTLE_MIN_INTERVAL=2
WHATSAPP_THROTTLE_MAX_INTERVAL=3
WHATSAPP_THROTTLE_KEY=global
WHATSAPP_VALIDATION_TIMEOUT=5
WHATSAPP_VALIDATION_CACHE_TTL=300
WHATSAPP_VALIDATION_ALLOW_MANUAL=true
WHATSAPP_VALIDATION_RATE_LIMIT=10
WHATSAPP_VALIDATION_RATE_DECAY=60

# Recruitment WhatsApp uses its own Node engine; pair sender accounts in Settings.
# Requires Node.js and dependencies in plugins/cesa/rekrutmen/whatsapp-engine.
# The enabled value is a fallback; the saved database setting takes priority.
REKRUTMEN_WHATSAPP_ENABLED=true
REKRUTMEN_WHATSAPP_ENGINE_URL=http://127.0.0.1:3318
# Disable auto-start when the engine is managed by a separate service.
REKRUTMEN_WHATSAPP_ENGINE_AUTO_START=true
REKRUTMEN_WHATSAPP_NODE_BINARY=node
# Recruitment HTTP timeout is independent of the shared WAG timeout above (seconds).
REKRUTMEN_WHATSAPP_HTTP_TIMEOUT=20
REKRUTMEN_WHATSAPP_JOB_TIMEOUT=60

# Optional bank account validation for the public Form Transfer form.
FORM_TRANSFER_ACCOUNT_VALIDATION_ENABLED=false
FORM_TRANSFER_ACCOUNT_VALIDATION_ENDPOINT=https://netovas.com/api/cekrek/v1/account-inquiry
FORM_TRANSFER_ACCOUNT_VALIDATION_TIMEOUT=5
FORM_TRANSFER_ACCOUNT_VALIDATION_CACHE_TTL=300
FORM_TRANSFER_ACCOUNT_VALIDATION_ALLOW_MANUAL=true
FORM_TRANSFER_ACCOUNT_VALIDATION_RATE_LIMIT=10
FORM_TRANSFER_ACCOUNT_VALIDATION_RATE_DECAY=60

EXIT_CLEARANCE_RECAPTCHA_ENABLED=false
EXIT_CLEARANCE_RECAPTCHA_SITE_KEY=
EXIT_CLEARANCE_RECAPTCHA_SECRET_KEY=

FORM_TRANSFER_RECAPTCHA_ENABLED=false
FORM_TRANSFER_RECAPTCHA_SITE_KEY=
FORM_TRANSFER_RECAPTCHA_SECRET_KEY=

LEAD_RECAPTCHA_ENABLED=false
LEAD_RECAPTCHA_SITE_KEY=
LEAD_RECAPTCHA_SECRET_KEY=

REKRUTMEN_RECAPTCHA_ENABLED=false
REKRUTMEN_RECAPTCHA_SITE_KEY=
REKRUTMEN_RECAPTCHA_SECRET_KEY=
