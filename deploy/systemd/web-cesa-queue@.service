[Unit]
Description=Web CESA Consolidated Queue Worker %i
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/web-cesa-new
ExecStart=/usr/bin/php /var/www/web-cesa-new/artisan queue:work database --queue=whatsapp,notifications,cesa-exports,rekrutmen-ai,default --sleep=1 --tries=3 --backoff=10 --timeout=300 --max-time=3600
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
